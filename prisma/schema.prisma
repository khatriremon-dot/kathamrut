generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Novel {
  id          String    @id @default(cuid())
  title       String
  author      String
  description String
  coverUrl    String    @default("")
  language    String    @default("en")
  category    String    @default("fiction")
  chapters    Chapter[]
  rating      Float     @default(4.5)
  views       Int       @default(0)
  status      String    @default("ongoing")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([language])
  @@index([category])
  @@index([status])
}

model Chapter {
  id        String   @id @default(cuid())
  novelId   String
  title     String
  content   String
  number    Int
  novel     Novel   @relation(fields: [novelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([novelId, number])
  @@index([novelId])
}

model RoleplayStory {
  id          String            @id @default(cuid())
  title       String
  description String
  coverUrl    String            @default("")
  language    String            @default("en")
  genre       String            @default("adventure")
  scenes      RoleplayScene[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([language])
  @@index([genre])
}

model RoleplayScene {
  id        String        @id @default(cuid())
  storyId   String
  title     String
  narrative String
  imageUrl  String        @default("")
  choices   String        @default("[]")
  isStart   Boolean       @default(false)
  story     RoleplayStory @relation(fields: [storyId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@index([storyId])
  @@index([isStart])
}