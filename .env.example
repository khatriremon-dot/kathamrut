# ============================================================
# NEON POSTGRESQL — KATHAMRUT
# ============================================================
# Replace the placeholders below with your actual Neon credentials.
# Get them from: https://console.neon.tech → your project → Connection Details
#
# Pooled connection (for app queries via PgBouncer):
DATABASE_URL="postgresql://kathamrut_user:your_password@ep-xyz.us-east-2.aws.neon.tech/kathamrut?sslmode=require&pgbouncer=true"
#
# Direct connection (for migrations & seeding only, bypasses pooler):
DIRECT_DATABASE_URL="postgresql://kathamrut_user:your_password@ep-xyz.us-east-2.aws.neon.tech/kathamrut?sslmode=require"

# ============================================================
# GITHUB — for deployments & CI/CD
# ============================================================
GITHUB_TOKEN="your_github_personal_access_token"

# ============================================================
# NETLIFY — for deployment
# ============================================================
NETLIFY_AUTH_TOKEN="your_netlify_auth_token"
